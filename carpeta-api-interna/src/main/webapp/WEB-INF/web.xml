<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Carpeta: API REST INTERNA</display-name>
 
    <!-- Paràmetre que indica els locales soportats -->
    <context-param>
        <param-name>es.caib.carpeta.commons.rest.supportedLocales</param-name>
        <param-value>ca,es</param-value>
    </context-param>

    <!-- Any file in the root path -->
    <servlet-mapping>   
        <servlet-name>default</servlet-name>
        <url-pattern>/ignore.html</url-pattern> 
    </servlet-mapping>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>carpeta_api_interna_secured</web-resource-name>
            <url-pattern>/secure/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>CAR_WS</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <!-- Per defecte BASIC. Si profile -Pcaib llavors KEYCLOAK  -->
        <auth-method>${auth.method}</auth-method>
        <realm-name>Govern de les Illes Balears</realm-name>
    </login-config>

    <security-role>
        <description>Usuari Aplicació de Carpeta</description>
        <role-name>CAR_WS</role-name>
    </security-role>

</web-app>